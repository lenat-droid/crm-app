# Use a separate, >=32-character secret, shared only with the AIM server.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55432/crm_aim_e2e
NEXTAUTH_URL=http://127.0.0.1:3000
NEXTAUTH_SECRET=
CRM_INGEST_TOKEN=
# Optional assignment; absent means only ADMIN sees new AIM requests.
AIM_LEAD_OWNER_ID=
AIM_LEAD_REGION=
CRM_PUBLIC_URL=http://127.0.0.1:3000
MAIL_PROVIDER=emailjs
MAIL_FROM=
MAIL_DOMAIN=
MAIL_TO=
MAIL_MAX_ATTEMPTS=5
MAIL_RETRY_BASE_MS=60000
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Local stage inbox, or an existing authenticated TLS SMTP provider.
SMTP_HOST=127.0.0.1
SMTP_PORT=11025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
